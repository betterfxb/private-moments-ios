{
  "sourceLanguage": "en",
  "strings": {
    "Private Moments": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "私密时刻"}}}},
    "Starts a private session timer": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "开始私密计时"}}}},
    "Load your journal before starting a record.": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "请先读取本机记录，再开始记录。"}}}},
    "You can add your reflection when you finish.": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "结束后，可以慢慢写下此刻的感受。"}}}},
    "Your space, your choice.": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "你的空间，由你做主。"}}}},
    "Your journal stays on this device. Manage its privacy and backups here.": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "记录保存在这台设备上。在这里管理隐私和备份。"}}}},
    "Your backups can contain private notes. Keep them somewhere you trust.": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "备份可能包含私密笔记，请将它保存在你信任的位置。"}}}},
    "Private notes are included in exported backups.": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "导出的备份会包含私密笔记。"}}}},
    "Add past moment": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "补记"}}}},
    "Adds a record without starting the timer": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "直接填写记录，不启动计时"}}}},
    "Date and duration": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "日期与时长"}}}},
    "Occurrence date": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "发生日期"}}}},
    "Start time": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "开始时间"}}}},
    "Minutes": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "分钟"}}}},
    "Seconds": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "秒"}}}},
    "Yesterday": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "昨天"}}}},
    "View a day": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "按日期查看"}}}},
    "Show day": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "查看当天"}}}},
    "Show recent moments": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "查看最近记录"}}}},
    "No moments on this day": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "这一天还没有记录"}}}},
    "Choose another day or add a past moment.": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "选择其他日期，或补记这一刻。"}}}},
    "Shows moments from this day": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "查看这一天的记录"}}}},
    "Enter whole minutes and 0–59 seconds, up to 30 days in total.": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "请填写整数分钟及 0–59 秒，总时长不超过 30 天。"}}}},
    "Choose a date and time that is not in the future.": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "请选择不晚于现在的日期和时间。"}}}},
    "Done": {
      "localizations": {
        "zh-Hans": {
